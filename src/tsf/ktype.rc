#include "resource.h"
#include <winres.h>

STRINGTABLE
BEGIN
    IDS_PROJNAME            "KType"
    IDS_KTYPE_DESCRIPTION   "KType Vietnamese Input Method"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KType Project"
            VALUE "FileDescription",  "KType Vietnamese IME"
            VALUE "FileVersion",      "0.1.0"
            VALUE "InternalName",     "KType"
            VALUE "OriginalFilename", "KType.dll"
            VALUE "ProductName",      "KType"
            VALUE "ProductVersion",   "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
